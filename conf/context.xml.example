<Context>
    <!-- JAASRealm para Mock Login -->
    <Realm className="org.apache.catalina.realm.JAASRealm" appName="BradescoLDAPLogin"
        userClassNames="br.com.bradesco.web.aq.application.security.authentication.userdetails.impl.BradescoUserDetailsJAASImpl"
        roleClassNames="br.com.bradesco.web.aq.application.security.authorization.impl.BradescoAuthorityImpl" />

    <!-- BeanManager CDI -->
    <Resource name="BeanManager" auth="Container"
        type="javax.enterprise.inject.spi.BeanManager"
        factory="org.apache.webbeans.container.ManagerObjectFactory" />

    <!-- Oracle DataSource - Configuracao TU -->
    <Resource name="jdbc/intranet_npco_npcod000_oracle"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="oracle.jdbc.OracleDriver"
              url="jdbc:oracle:thin:@//10.73.21.106:1521/xe"
              username="admin"
              password="admin"
              maxActive="20"
              maxIdle="10"
              maxWait="-1"
              validationQuery="SELECT 1 FROM DUAL"
              testOnBorrow="true"
              testWhileIdle="true"
              timeBetweenEvictionRunsMillis="30000"
              minEvictableIdleTimeMillis="60000" />
</Context>
